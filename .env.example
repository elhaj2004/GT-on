# ============================================================
# Virtual Closet — configuration d'environnement
# Copie ce fichier en `.env` et remplis les valeurs.
# ============================================================

# --- Gemini (Nano Banana / gemini-2.5-flash-image) -----------
# Clé API : https://aistudio.google.com/apikey
# Optionnel : la clé peut aussi être saisie directement dans
# l'application (page Profil), elle sera stockée sur l'appareil.
VITE_GEMINI_API_KEY=

# Modèle image à utiliser (défaut : gemini-2.5-flash-image)
# VITE_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Firebase (Firestore + Storage) --------------------------
# Optionnel : sans configuration Firebase, l'application stocke
# tout en local sur l'appareil (IndexedDB).
# Console : https://console.firebase.google.com → Paramètres du projet
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
